<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Room + SQLCipher database files -->
    <exclude domain="database" path="mcdcs_db" />
    <exclude domain="database" path="mcdcs_db-wal" />
    <exclude domain="database" path="mcdcs_db-shm" />

    <!-- DatabasePassphraseManager stores the encrypted SQLCipher passphrase here -->
    <exclude domain="sharedpref" path="mcdcs_secure_vault.xml" />

    <!-- Internal files - captured photos -->
    <exclude domain="file" path="." />

    <!-- External files -->
    <exclude domain="external" path="." />
</full-backup-content>
